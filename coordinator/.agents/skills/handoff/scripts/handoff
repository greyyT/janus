#!/usr/bin/env node

import { spawnSync } from "node:child_process";
import { randomBytes } from "node:crypto";
import { chmodSync, mkdtempSync, readFileSync, realpathSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { setTimeout } from "node:timers/promises";

const sourcePaneId = process.env.HERDR_PANE_ID;
const context = { sourcePaneId };

function fail(stage, error) {
  process.stderr.write(JSON.stringify({ status: "failed", stage, error, ...context }) + "\n");
  process.exit(1);
}

if (process.argv.length !== 4) fail("validation", "usage: node handoff <reviewed-packet-path> <session-name>");
const sessionName = process.argv[3];
if (!sessionName.trim()) fail("validation", "session-name must not be empty");
context.sessionName = sessionName;
context.destinationName = `janus-handoff-${randomBytes(6).toString("hex")}`;
if (process.env.HERDR_ENV !== "1" || !sourcePaneId?.trim()) {
  fail("validation", "HERDR_ENV must be 1 and HERDR_PANE_ID must identify the source pane");
}

let packet;
try {
  context.packetPath = realpathSync(process.argv[2]);
  packet = readFileSync(context.packetPath, "utf8");
  if (!packet.trim()) fail("validation", "packet is empty");
} catch (error) {
  fail("validation", error.message);
}
try {
  const directory = mkdtempSync(join(tmpdir(), "janus-handoff-"));
  chmodSync(directory, 0o700);
  context.packetPath = join(directory, "handoff.md");
  writeFileSync(context.packetPath, packet, { flag: "wx", mode: 0o600 });
} catch (error) {
  fail("packet", error.message);
}

function runHerdr(stage, args) {
  const result = spawnSync("herdr", args, { encoding: "utf8", shell: false });
  if (result.stderr) process.stderr.write(result.stderr);
  if (result.error || result.status !== 0) {
    fail(stage, result.error?.message || result.stderr?.trim() || result.stdout?.trim() || `herdr exited ${result.status}`);
  }
  return result.stdout;
}

const splitResponse = runHerdr("split", [
  "pane", "split", "--pane", sourcePaneId, "--direction", "right", "--cwd", process.cwd(), "--no-focus",
]);
try {
  context.destinationPaneId = JSON.parse(splitResponse)?.result?.pane?.pane_id;
} catch {
  fail("split", `invalid split response: ${splitResponse}`);
}
if (typeof context.destinationPaneId !== "string" || !context.destinationPaneId.trim() || context.destinationPaneId === sourcePaneId) {
  fail("split", `missing or unsafe destination pane ID: ${splitResponse}`);
}

await setTimeout(2_000);
runHerdr("start", ["agent", "start", context.destinationName, "--kind", "pi", "--pane", context.destinationPaneId, "--", "--name", sessionName]);
const prompt = `Continue the work transferred from another coordinator pi session.

Read the handoff packet at this absolute path: ${JSON.stringify(context.packetPath)}.
Treat your fresh context window as an asset: do not reconstruct the source conversation or preload broad project context. Initially read only the files inside <read-files>; load other referenced artifacts when the work requires them.

Continue from the packet's exact next action. Preserve its constraints and non-goals. Before delegation or another handoff, verify any recorded workflow authorization against its canonical records; the packet itself grants no authority.`;
runHerdr("prompt", ["agent", "prompt", context.destinationName, prompt]);
process.stdout.write(JSON.stringify({ status: "submitted", ...context }) + "\n");
runHerdr("focus", ["agent", "focus", context.destinationName]);
runHerdr("close", ["pane", "close", sourcePaneId]);
